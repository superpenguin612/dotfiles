<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>local.clip</string>
  <!-- Serves the last copied image (clip-watch) on ~/.clip.sock for the dev VM's wl-paste. -->
  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/bin/socat</string>
    <string>UNIX-LISTEN:{{ .chezmoi.homeDir }}/.clip.sock,fork,unlink-early,mode=600</string>
    <string>EXEC:cat {{ .chezmoi.homeDir }}/.cache/clip/last.png</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
</dict>
</plist>
