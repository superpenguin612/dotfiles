#!/bin/sh
# sesh's startup command for a new session: window 2 runs claude, window 3 is
# a shell, both in this folder; window 1 (this one) runs nvim.
if [ -n "$TMUX" ]; then
	w=$(tmux new-window -d -P -F '#{window_id}' -c "$PWD")
	tmux send-keys -t "$w" claude Enter
	tmux new-window -d -c "$PWD"
fi
nvim
