# PATH and environment for every zsh, agents included.
typeset -U path
path=(~/.local/bin $path)
{{- if eq .chezmoi.os "darwin" }}
[[ -x /opt/homebrew/bin/brew ]] && eval "$(/opt/homebrew/bin/brew shellenv)"
{{- end }}
# mise shims give non-interactive shells (agents, scripts) the tools; interactive ones use `mise activate`.
path=(~/.local/share/mise/shims $path)
export EDITOR=nvim VISUAL=nvim
(( $+commands[nvim] )) || export EDITOR=vim VISUAL=vim

[[ -r ~/.zshenv.local ]] && source ~/.zshenv.local
