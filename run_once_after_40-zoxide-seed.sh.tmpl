#!/bin/sh
# Adds every git repo under ~/src to zoxide once, so the picker and `cd` know
# them before I've visited them.
command -v zoxide >/dev/null 2>&1 || exit 0
[ -d "{{ .chezmoi.homeDir }}/src" ] || exit 0
find "{{ .chezmoi.homeDir }}/src" -mindepth 2 -maxdepth 3 -name .git -type d -prune |
	sed 's#/\.git$##' | while read -r d; do zoxide add "$d"; done
