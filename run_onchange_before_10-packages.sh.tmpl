{{ if eq .profile "full" -}}
#!/bin/sh
# System packages mise can't install. Brewfile hash: {{ include "Brewfile" | sha256sum }}
set -eu
{{ if eq .chezmoi.os "darwin" -}}
command -v brew >/dev/null || { echo "packages: install Homebrew first (https://brew.sh)"; exit 0; }
brew bundle --file={{ joinPath .chezmoi.sourceDir "Brewfile" | quote }}
{{- else if lookPath "apt-get" -}}
pkgs="zsh tmux build-essential unzip curl git socat python3-venv xz-utils gzip tar php-cli php-mbstring"
missing=$(for p in $pkgs; do dpkg -s "$p" >/dev/null 2>&1 || echo "$p"; done)
[ -z "$missing" ] && exit 0
if [ "$(id -u)" = 0 ]; then sudo=; elif sudo -n true 2>/dev/null; then sudo=sudo; else
  echo "packages: no sudo, skipping apt install of" $missing; exit 0
fi
$sudo apt-get update -qq
$sudo env DEBIAN_FRONTEND=noninteractive apt-get install -y -qq $missing
{{- end }}
{{ end -}}
